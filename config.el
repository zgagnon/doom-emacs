(defun my/ensure-envrc-loaded-once ()
  "Ensure envrc is loaded once per project for Elixir files."
  (when (and (buffer-file-name)
             (string-match-p "\\.exs?$" (buffer-file-name)))
    (let* ((project-root (locate-dominating-file (buffer-file-name) ".envrc"))
           (project-root (when project-root (expand-file-name project-root))))
      (when (and project-root
                 (not (member project-root my/envrc-loaded-projects)))
        (let ((default-directory project-root))
          (envrc-allow)
          (envrc-reload)
          (push project-root my/envrc-loaded-projects)
          (message "Loaded direnv for project: %s" project-root))))))

;; Only hook to elixir-ts-mode, not find-file-hook
(add-hook 'elixir-ts-mode-hook #'my/ensure-envrc-loaded-once)

;; Universal Elixir-LS Environment Integration
;; This configures LSP to use a universal wrapper script that automatically
;; detects and activates the appropriate development environment:
;; The wrapper script (~/.doom.d/nix-adapters/elixir-ls-universal-wrapper.sh) handles:
;; - Nix flake detection and 'nix develop' activation (priority 1)
;; - Direnv detection and 'direnv exec' activation (priority 2)  
;; - Fallback to global elixir-ls for projects without environment management
;; This eliminates the need for per-project .dir-locals.el configuration.
(after! lsp-mode
  (lsp-register-client
   (make-lsp-client
    :new-connection (lsp-stdio-connection
                     (lambda ()
                       (list (expand-file-name "~/.doom.d/nix-adapters/elixir-ls-universal-wrapper.sh"))))
    :major-modes '(elixir-mode elixir-ts-mode)
    :priority 1
    :server-id 'elixir-ls-universal
    :initialization-options (lambda () (list :dialyzerEnabled :json-false)))))

(setq treesit-language-source-alist
      (append treesit-language-source-alist
              '((rust "https://github.com/tree-sitter/tree-sitter-rust"))))

(add-to-list 'major-mode-remap-alist '(rust-mode . rust-ts-mode))

