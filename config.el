(defun my/org-format-code-block ()
  "Format code block at point by opening special edit buffer, formatting, and returning."
  (interactive)
  (if (org-in-src-block-p)
      (progn
        (org-edit-special)
        ;; Use Doom's format function
        (+format/region-or-buffer)
        ;; Return to org buffer
        (org-edit-src-exit))
    (message "Not in an org source block")))

