    (lambda (directory)
      (if directory
        (format "*Claude-Code:%s*"
          (file-name-nondirectory (directory-file-name directory)))
        "*Claude-Code:Global*")))

  ;; Nix develop integration for claude-code-ide
  ;; This ensures claude-code-ide runs in nix develop environments when available
  (defun claude-code-ide--with-nix-develop (orig-fun &rest args)
    "Advice to run claude-code-ide commands in nix develop environment when available."
    (let* ((current-dir default-directory)
           (wrapper-script (expand-file-name "~/.doom.d/nix-adapters/claude-code-nix-wrapper.sh"))
           (flake-dir (claude-code-ide--find-flake-dir current-dir)))
      (if (and (file-exists-p wrapper-script) flake-dir)
          (let ((default-directory flake-dir))
            (apply orig-fun args))
        (apply orig-fun args))))

  (defun claude-code-ide--find-flake-dir (dir)
    "Find the nearest directory containing a flake.nix file."
    (let ((current-dir (expand-file-name dir)))
      (while (and current-dir
                  (not (string= current-dir "/"))
                  (not (file-exists-p (expand-file-name "flake.nix" current-dir))))
        (setq current-dir (file-name-directory (directory-file-name current-dir))))
      (when (and current-dir (file-exists-p (expand-file-name "flake.nix" current-dir)))
        current-dir)))

  ;; Add advice to ensure claude-code-ide commands run in nix develop context
  (advice-add 'claude-code-ide :around #'claude-code-ide--with-nix-develop)
  
  ;; Also modify the shell command to use our wrapper
  (defun claude-code-ide--get-wrapped-shell ()
    "Get shell command wrapped for nix develop environment."
    (let ((wrapper-script (expand-file-name "~/.doom.d/nix-adapters/claude-code-nix-wrapper.sh")))
      (if (file-exists-p wrapper-script)
          (list wrapper-script shell-file-name)
        (list shell-file-name))))

  ;; Set the shell command for claude-code-ide to use our wrapper
  (setq claude-code-ide-shell-command-function #'claude-code-ide--get-wrapped-shell)

