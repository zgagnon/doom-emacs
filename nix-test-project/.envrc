#!/usr/bin/env bash
# Automatically enter nix develop environment when entering this directory
# This integrates with direnv for seamless environment switching

if ! has nix_direnv_version || ! nix_direnv_version 3.0.4; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.4/direnvrc" "sha256-DzlYZ33mWF/Gs8DDeyjr8mnVmQGx7ASYqA5WlxwvBG4="
fi

# Use nix flake for development environment
use flake

# Log when environment is loaded
echo "🔧 Loaded nix development environment via direnv"